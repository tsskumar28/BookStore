{
  "ConnectionStrings": {
    "Default": "Data Source=bookstore.db"
  },
  "Cors": {
    "Origins": [ "http://localhost:4200" ]
  },
  "OpenLibrary": {
    "SearchBaseUrl": "https://openlibrary.org/",
    "CoversBaseUrl": "https://covers.openlibrary.org/",
    "UserAgent": "BookStoreAssessment/1.0 (contact: dev@example.com)",
    "TimeoutSeconds": 8,
    "ResultLimit": 10
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{CorrelationId}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
